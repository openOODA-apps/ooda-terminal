// # ooda-console Theme Resolution
//
// Logline: Resolve the console palette under the environment overrides and name the glyph family of the palette.
//
// Setup: Imports the canonical ooda-standard ootheme palette engine; the environment overrides need &EnvCap.
//
// Beats:
//   1. ooconsole_glyph_style maps a palette name to its glyph family.
//   2. ooconsole_theme_resolve honors NO_COLOR, OODA_NO_COLOR, and OO_NO_COLOR, and the OODA_THEME override.
//   3. Refuse an unknown palette name by falling back to the canonical dark palette.

import "ooda-standard/core/app/ui/ootheme.oo";
import "ooda-standard/fs/process/env.oo";

pub fn ooconsole_glyph_style(p: OoThemePalette) -> String {
    if p.name == "1982" { return "arcade-block"; }
    if p.name == "ooda-light" { return "retro-round"; }
    if p.name == "no-color" { return "plain"; }
    return "cyber-sharp";
}

pub fn ooconsole_theme_resolve(env: &EnvCap, requested: String) -> OoThemePalette {
    let mut theme: String = "";
    let mut no_color: Bool = false;
    let r1: Result[String, String] = env_get(env, "OODA_THEME");
    if r1.is_ok() {
        let v: String = match r1 { Ok(s) => s, Err(_) => "" };
        if chars_len(v) > 0 { theme = v; }
    }
    let r2: Result[String, String] = env_get(env, "NO_COLOR");
    if r2.is_ok() {
        let v: String = match r2 { Ok(s) => s, Err(_) => "" };
        if chars_len(v) > 0 { no_color = true; }
    }
    let r3: Result[String, String] = env_get(env, "OODA_NO_COLOR");
    if r3.is_ok() {
        let v: String = match r3 { Ok(s) => s, Err(_) => "" };
        if chars_len(v) > 0 { no_color = true; }
    }
    let r4: Result[String, String] = env_get(env, "OO_NO_COLOR");
    if r4.is_ok() {
        let v: String = match r4 { Ok(s) => s, Err(_) => "" };
        if chars_len(v) > 0 { no_color = true; }
    }
    if no_color { return ootheme_resolve("no-color"); }
    if chars_len(theme) > 0 && ootheme_known(theme) { return ootheme_resolve(theme); }
    if ootheme_known(requested) { return ootheme_resolve(requested); }
    return ootheme_resolve("ooda-dark");
}
