// # ooda-terminal Desktop Window Verbs
//
// Logline: Open the desktop window, draw the styled grid into the frame canvas, and forward keys to the child.
//
// Setup: Declared capability: Process, FsRead, Fs, FsWrite, Env, Ffi. The window and font come from ooda-standard.
//
// Beats:
//   1. Open the window and the child, refusing to start without a usable surface.
//   2. Draw the styled row runs of the engine grid into every frame and present it.
//   3. Translate a key event into the bytes the child expects and write them into the pty.

import "core/replay.oo";
import "core/pty.oo";
import "core/rows.oo";
import "core/surface.oo";
import "core/config.oo";
import "cli/cli.oo";
import "ooda-standard/core/app/ui/wayland/window.oo";
import "ooda-standard/core/app/ui/wayland/input.oo";
import "ooda-standard/core/app/ui/ootheme.oo";

pub const TERMINAL_GUI_FRAME_LIMIT: Int = 4096;

fn ooterm_gui_draw(ffi: &FfiCap, c: UiCanvas, bf: &mut UiFont, s: TerminalReplay,
        pal: OoThemePalette) -> Void {
    let g: TermGrid = terminal_replay_grid(s);
    let rows: List[TerminalRow] = terminal_rows_build(g);
    terminal_surface_draw(ffi, c, bf, rows, pal);
}

pub fn ooterm_gui_run(fs_r: &FsReadCap, fs_w: &FsWriteCap, fs: &FsCap, env: &EnvCap,
        proc: &ProcessCap, ffi: &FfiCap, args: List[String], name: String) -> Result[Int, String] {
    let cfg: TerminalConfig = terminal_config_load(fs_r, "");
    let mut prog: String = ooterm_cli_operand(args);
    if prog == "" { prog = cfg.prog; }
    if prog == "" {
        println("ERR " + name + ": gui needs a program or a configured prog");
        return Ok(2);
    }
    let mut win: WlWindow = terminal_surface_open(fs, fs_w, env, ffi, "Terminal", cfg.cols, cfg.rows);
    if !win.ok || win.closed {
        println("ERR " + name + ": gui cannot open a wayland surface");
        return Ok(2);
    }
    let p: TerminalPty = terminal_pty_open(proc, prog, list_new(), cfg.rows, cfg.cols);
    if p.valid == false {
        wl_win_close(ffi, fs, &mut win);
        println("ERR " + name + ": gui refused " + prog + " (" + p.err + ")");
        return Ok(2);
    }
    let pal: OoThemePalette = ooterm_theme_resolve(env, "ooda-dark");
    let mut bf: UiFont = terminal_surface_font(fs_r, env, 14);
    let mut s: TerminalReplay = terminal_replay_new(cfg.cols, cfg.rows);
    let mut frames: Int = 0;
    while !win.closed && frames < TERMINAL_GUI_FRAME_LIMIT {
        let chunk: String = terminal_pty_read(proc, p, 16);
        if bytes_len(chunk) > 0 { s = terminal_replay_feed(s, chunk); }
        let c: UiCanvas = wl_win_begin_frame(&mut win);
        if c.addr != 0 {
            ooterm_gui_draw(ffi, c, &mut bf, s, pal);
            let _pr: Bool = wl_win_present(fs, &mut win);
            frames = frames + 1;
        }
        let evs: List[UiEvent] = wl_win_poll(ffi, fs, &mut win, 16);
        let mut i: Int = 0;
        while i < list_len(evs) {
            let ev: UiEvent = list_get(&evs, i);
            if ev.kind == 2 { win.closed = true; }
            if ev.kind == 7 {
                let action: String = ui_evdev_action(ev.key);
                let bytes: String = terminal_key_bytes(action, ev.ch);
                if bytes != "" { terminal_pty_write(proc, p, bytes); }
            }
            i = i + 1;
        }
    }
    let _ec: Int = terminal_pty_close(proc, p);
    wl_win_close(ffi, fs, &mut win);
    println(name + ": gui frames=" + frames.to_string());
    return Ok(0);
}
