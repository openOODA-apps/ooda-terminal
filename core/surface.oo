// # ooda-console Surface Binding
//
// Logline: Bind the engine grid to a Wayland window: draw the styled row runs into the shared canvas and map a key
//   event to the bytes a child expects.
// Setup: Declared capability: Fs, FsWrite, Env, Ffi. The window, the canvas, and the font come from
//   ooda-standard/core/app/ui; this page owns no compositor protocol and no surface capability of its own.
// Beats:
//   1. Open the desktop window through the shared Wayland page and report whether the surface is usable.
//   2. Draw the styled row runs into the frame canvas, one run per style change, under the active palette.
//   3. Map a key event to the byte sequence a child in the pty expects, refusing anything unmapped.

import "ooda-standard/core/app/ui/wayland/window.oo";
import "ooda-standard/core/app/ui/font/atlas.oo";
import "ooda-standard/core/app/ui/font/sfnt.oo";
import "ooda-standard/core/app/ui/font/text.oo";
import "ooda-standard/core/app/ui/ootheme.oo";
import "ooda-standard/core/app/ui/widget/draw.oo";
import "ooda-standard/core/primitives/byte/byte.oo";
import "core/rows.oo";

pub const CONSOLE_APP_ID: String = "org.openooda.console";

pub fn console_surface_open(fs: &FsCap, fw: &FsWriteCap, env: &EnvCap, ffi: &FfiCap,
        title: String, cols: Int, rows: Int) -> WlWindow {
    let w: Int = cols * 9;
    let h: Int = rows * 18;
    return wl_win_open(fs, fw, env, ffi, title, CONSOLE_APP_ID, w, h);
}

pub fn console_surface_font(fs_r: &FsReadCap, env: &EnvCap, px: Int) -> UiFont {
    return ui_font_new(ttf_load_ui_font(fs_r, env, true), px);
}

pub fn console_surface_draw(ffi: &FfiCap, c: UiCanvas, bf: &mut UiFont, rows: List[ConsoleRow],
        pal: OoThemePalette) -> Void {
    if c.addr == 0 { return; }
    ui_fill_rect(ffi, c, ui_rect_new(0, 0, c.w, c.h), pal.bg_rgba);
    let lh: Int = bf.line_h;
    let mut r: Int = 0;
    while r < list_len(rows) {
        let row: ConsoleRow = list_get(rows, r);
        let mut x: Int = 4;
        let mut i: Int = 0;
        while i < list_len(row.runs) {
            let run: ConsoleRun = list_get(row.runs, i);
            let fg: Int = color_rgba(run.fg, true);
            let bg: Int = color_rgba(run.bg, false);
            let drawn: Int = ui_text_draw(ffi, c, bf, x, r * lh, run.text, ui_text_style(fg, bg, c.w - x));
            if drawn <= 0 { break; }
            x = x + drawn;
            i = i + 1;
        }
        r = r + 1;
    }
}

pub fn console_key_bytes(action: String, ch: String) -> String {
    if action == "enter" { return byte_chr(13); }
    if action == "backspace" { return byte_chr(127); }
    if action == "tab" { return byte_chr(9); }
    if action == "esc" { return byte_chr(27); }
    if action == "up" { return byte_chr(27) + "[A"; }
    if action == "down" { return byte_chr(27) + "[B"; }
    if action == "right" { return byte_chr(27) + "[C"; }
    if action == "left" { return byte_chr(27) + "[D"; }
    if action == "home" { return byte_chr(27) + "[H"; }
    if action == "end" { return byte_chr(27) + "[F"; }
    if action == "pgup" { return byte_chr(27) + "[5~"; }
    if action == "pgdn" { return byte_chr(27) + "[6~"; }
    if action == "delete" { return byte_chr(27) + "[3~"; }
    if chars_len(ch) == 1 { return ch; }
    return "";
}
